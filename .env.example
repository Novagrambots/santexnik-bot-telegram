# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID СУПЕР-админов через запятую (свой Telegram id узнать у @userinfobot).
# Супер-админы могут добавлять/удалять обычных админов из панели.
# Обычные админы имеют те же права, но не управляют списком админов.
ADMIN_IDS=123456789

# PostgreSQL. В docker-compose хост = имя сервиса "db".
# Значения должны совпадать с POSTGRES_* ниже.
DB_URL=postgresql+asyncpg://santexnik:santexnik@db:5432/santexnik

# Параметры контейнера PostgreSQL (используются docker-compose)
POSTGRES_USER=santexnik
POSTGRES_PASSWORD=santexnik
POSTGRES_DB=santexnik

# --- Стартовые значения напоминаний ---
# Задаются только при ПЕРВОМ запуске (пустая БД). Дальше меняются в админке
# (⚙️ Настройки) и хранятся в БД — правка .env после этого ни на что не влияет.

# Время ежедневной проверки напоминаний (по времени сервера)
REMINDER_HOUR=9
REMINDER_MINUTE=0

# Этапы напоминаний: за сколько дней до профилактики слать (через запятую, 0 = в день)
REMINDER_STAGES_DAYS=14,3,0
